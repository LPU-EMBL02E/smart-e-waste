# Shared formatting, so a PHP file, a C++ file and a Blade template do not fight
# over indentation across three toolchains.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,ino}]
indent_size = 2

# JS, CSS and JSON use the 4-space default, as the web app's files do
# (web/.prettierrc). YAML stays at 2.
[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.{md,mmd}]
trim_trailing_whitespace = false

[*.ini]
indent_size = 4

# The design prototypes' scripts and stylesheet were written in Prettier's
# default 2-space style and keep it (the override in web/.prettierrc).
[web/docs/wireframes/*.{js,css}]
indent_size = 2

[Makefile]
indent_style = tab
