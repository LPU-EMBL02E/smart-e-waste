# ---------------------------------------------------------------------------
# IoT-Based Smart E-Waste Collection and Monitoring System
# Copy to .env, then `php artisan key:generate` on a NEW install only.
#
# NEVER run key:generate on a host that has existing data: device secrets are
# encrypted with APP_KEY, and a new key makes every bin's secret unreadable
# (System_Plan.md §8). At handover, carry APP_KEY over with the data.
#
# Section references are to docs/System_Plan.md unless stated otherwise.
# ---------------------------------------------------------------------------

APP_NAME="Smart E-Waste"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The tunnel hostname is the single canonical browser URL. LAN HTTP is for the
# bin only, which is what keeps secure session cookies on without conflict (§7).
APP_URL=https://ewaste.example.test

# Store everything in UTC; convert only for display (§6).
APP_TIMEZONE=UTC
APP_LOCALE=en

# ---------------------------------------------------------------------------
# Database — MariaDB 11.8, InnoDB
# ---------------------------------------------------------------------------
# Set the collation explicitly. MariaDB 11.8's own default does not import into
# MySQL or older MariaDB, which would break the handover dump (§6).
#
# Create the database as:
#   CREATE DATABASE ewaste CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# with a dedicated user, not root (§7 step 3).

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ewaste
DB_USERNAME=ewaste
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Session, cache, queue
# ---------------------------------------------------------------------------
# All three are swappable through .env alone (§8.1). No Redis, no worker process.

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true with the tunnel hostname; false on the LAN demo fallback (§7).
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# `sync` runs jobs during the request. There is no queue worker (§3).
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Mail — two emails only: set your password, and forgot password (§7.2)
# ---------------------------------------------------------------------------
# Laravel's mailer is the adapter. No vendor SDK is ever called from app/.
#   development and tests : MAIL_MAILER=log   (writes mail to the log)
#   until handover        : MAIL_MAILER=resend + RESEND_API_KEY
#   after handover        : MAIL_MAILER=smtp  + the university's SMTP settings
#
# Resend needs a verified domain: without one it delivers only to the account
# owner's own address. Free plan: 100 emails a day, 3,000 a month.

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ewaste.example.test"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# After handover, switch MAIL_MAILER to smtp and fill these in:
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Application settings — config/ewaste.php, §6.3
# ---------------------------------------------------------------------------
# Only settings appear here. Values an admin changes while the system runs live
# in the database: the four reward rule variables, each reward's price, and each
# bin's fill threshold and calibration.

# How long an OPEN session lasts, in seconds. Also sent to the bin.
EWASTE_SESSION_TIMEOUT_SECONDS=90

# How long an ACCEPTED session waits for `complete` before it is listed for
# admin review, in minutes.
EWASTE_REVIEW_THRESHOLD_MINUTES=10

# How far a device's timestamp may be from server time, in seconds.
EWASTE_SIGNATURE_WINDOW_SECONDS=60

# Retry-After sent with DB_UNAVAILABLE, in seconds (API_Design.md P7).
EWASTE_RETRY_AFTER_SECONDS=5

# Used for display, and for the midnight the daily points cap counts from.
EWASTE_DISPLAY_TIMEZONE=Asia/Manila

# How often the admin dashboard polls its summary, in seconds.
EWASTE_DASHBOARD_POLL_SECONDS=10

# The heaviest deposit the load cell, platform and actuator can handle, in
# grams. Caps maximum_weight_g when an admin saves a reward rule.
# TODO(team): no value is set in the plan (API_Design.md P37, §10 q7). Measure
# it once the actuator is chosen. Left empty = the check is skipped.
EWASTE_HARDWARE_MAX_WEIGHT_G=

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------
# Tailwind is compiled with Vite on a DEV MACHINE, never on the Pi (§3). Deploy
# the built assets.
VITE_APP_NAME="${APP_NAME}"
